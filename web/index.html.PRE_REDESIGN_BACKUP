            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-400 text-xs bg-black/20 rounded-xl border border-red-950/40 p-4">
                        <div class="text-base mb-1">🔍 Žiadne nájdené články</div>
                        <div>Pre zvolené kľúčové slová sa v tomto okne nenašiel žiadny článok.</div>
                        <button onclick="clearRadarFilter()" class="mt-3 px-3 py-1 bg-red-900/60 hover:bg-red-800 text-red-200 text-xs rounded-lg transition border border-red-700">
                            Zobraziť všetky správy
                        </button>
                    </div>
                `;
                return;
            }

            let html = '';
            filtered.forEach(a => {
                const detected = getArticleDetectedKeywords(a);

                html += `
                    <div onclick="openArticleModal(${a.id})" class="p-3 rounded-xl bg-gray-950/90 border border-red-950/80 hover:border-red-600/70 hover:bg-red-950/30 cursor-pointer transition shadow-md shadow-black/40">
                        <div class="flex justify-between items-center text-[11px] text-gray-400 mb-1">
                            <span class="font-bold text-red-400 flex items-center gap-1.5">
                                ${(a.url && a.url.includes('t.me')) || (a.media_name && a.media_name.includes('TG')) ? '<span class="px-1 py-0.2 bg-cyan-950 text-cyan-300 border border-cyan-800 rounded text-[8px] font-bold">✈️ TG</span>' : '<span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>'}
                                <span>${a.media_name}</span>
                                ${!currentSelectedCountryIso && a.country_name ? `<span class="px-1.5 py-0.2 rounded bg-gray-900 border border-gray-700 text-gray-300 text-[9px] font-mono">${a.country_name} (${a.country_iso})</span>` : ''}
                            </span>
                            <span class="text-gray-500 font-mono text-[10px]">${new Date(a.published_at || a.scraped_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</span>
                        </div>
                        <div class="text-xs font-semibold text-white mb-1.5 leading-snug hover:text-red-300 transition">
                            ${a.title_orig}
                        </div>

                        <!-- Zobrazenie všetkých zachytených slov a alarmov pre tento článok -->
                        ${(() => {
                            if (!detected || detected.length === 0) return '';
                            let tagsHtml = '';
                            detected.forEach(item => {
                                const isTarget = isWordActiveInFilter(item.alertName) || isWordActiveInFilter(item.word);
                                const isCustom = item.type === 'custom';
                                const bgCls = isTarget 
                                    ? 'bg-red-600 text-white border-red-300 shadow-sm font-bold ring-1 ring-red-400' 
                                    : (isCustom ? 'bg-blue-950/90 border-blue-800 text-blue-200' : 'bg-red-950/90 border-red-800 text-red-200');
                                const dotCls = isCustom ? 'bg-blue-400' : 'bg-red-500 animate-ping';

                                tagsHtml += `
                                    <div class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded border text-[10px] mr-1 mb-1 ${bgCls}">
                                        <span class="w-1.5 h-1.5 rounded-full ${dotCls}"></span>
                                        <span class="font-bold opacity-80">${item.alertName}:</span>
                                        <span class="font-mono ${isTarget ? 'bg-black/30' : (isCustom ? 'bg-blue-900' : 'bg-red-900')} text-white px-1 rounded">${item.word}</span>
                                    </div>
                                `;
                            });
                            return `<div class="flex flex-wrap items-center mb-1">${tagsHtml}</div>`;
                        })()}

                        ${a.title_en && a.title_en !== a.title_orig ? `
                            <div class="text-[11px] text-red-200 bg-red-950/60 p-1.5 rounded border border-red-900/40 mb-1 leading-snug">
                                <span class="font-bold uppercase text-[9px] bg-red-800 px-1 rounded text-white mr-1">EN</span>
                                <span>${a.title_en}</span>
                            </div>
                        ` : ''}
                        ${a.title_sk && a.title_sk !== a.title_orig ? `
                            <div class="text-[11px] text-emerald-300 bg-emerald-950/40 p-1.5 rounded border border-emerald-900/30 mb-1 leading-snug">
                                <span class="font-bold uppercase text-[9px] bg-emerald-800 px-1 rounded text-white mr-1">SK</span>
                                <span>${a.title_sk}</span>
                            </div>
                        ` : ''}
                        <div class="mt-2 text-[10px] text-red-400/80 flex items-center justify-between border-t border-red-950/80 pt-1.5">
                            <span>📄 Klikni pre prepis článku</span>
                            <span>Čítať →</span>
