                    </div>
                `;
            });
            container.innerHTML = html;
        }

                function showAllCountriesGlobeArticles() {
            radarActiveFilterWords.clear();
            toggleRadarWordInput(false);
            loadGlobeCountryArticles('', 'Všetky krajiny sveta', 0);
        }

        async function loadGlobeCountryArticles(iso, name, count) {
            currentSelectedCountryIso = iso || '';
            currentSelectedCountryName = name || (iso ? name : 'Všetky krajiny sveta');
            currentCountryTotalCount = count || 0;

            const countryTitleEl = document.getElementById('globe-selected-country');
            if (countryTitleEl) {
                if (iso) {
                    countryTitleEl.innerHTML = `<span>📍 ${name} (${iso})</span>`;
                } else {
                    countryTitleEl.innerHTML = `<span>🌐 Všetky krajiny sveta</span>`;
                }
            }

            const countEl = document.getElementById('globe-selected-count');
            if (countEl) {
                countEl.innerText = count ? `${count} správ` : 'Načítavam...';
            }

            const container = document.getElementById('globe-country-articles');
            const wordsHeader = document.getElementById('globe-radar-active-words');
            if (container) container.innerHTML = '<div class="text-center py-12 text-gray-500 text-xs">Načítavam články...</div>';
            if (wordsHeader) wordsHeader.innerHTML = '<span class="text-[10px] text-gray-500">Zisťujem zachytené alarmy...</span>';

            try {
                // Vždy načítame čerstvé systémové alarmy z DB pre zobrazenie v radare
                const alertsPromise = fetch('/api/alerts').then(r => r.json()).catch(() => []);

                let activeQuery = globeQuery || '';
                if (radarActiveFilterWords && radarActiveFilterWords.size > 0) {
                    activeQuery = getSearchQueryForActiveWords();
                }
                let url = `/api/articles?period=${globePeriod}&limit=70`;
                if (iso) url += `&country=${iso}`;
                if (activeQuery) url += `&query=${encodeURIComponent(activeQuery)}`;
                
                let hitsUrl = `/api/alert-hits?limit=50`;
                if (iso) hitsUrl += `&country=${iso}`;

                const [res, hitsRes, freshAlerts] = await Promise.all([
                    fetch(url),
                    fetch(hitsUrl),
                    alertsPromise
                ]);
                if (freshAlerts && freshAlerts.length > 0) {
                    cachedSystemAlerts = freshAlerts;
                }
                const articles = await res.json();
                const alertHits = await hitsRes.json();

                if (!iso && !count) {
                try {
                    const statsRes = await fetch(`/api/stats?period=${globePeriod}`);
                    const statsData = await statsRes.json();
                    if (statsData && statsData.total_articles) {
                        currentCountryTotalCount = statsData.total_articles;
                        if (countEl) countEl.innerText = `${statsData.total_articles} správ`;
                    }
                } catch(e) {}
            }

            if (articles.length === 0) {
                currentGlobeCountryArticles = [];
                container.innerHTML = '<div class="text-center py-12 text-gray-500 text-xs">Žiadne články.</div>';
                wordsHeader.innerHTML = '';
                return;
            }

                // Spáruj alert hits s článkami aj v prípade, ak v matched_alerts niektoré chýbajú
                const hitMap = new Map();
                if (Array.isArray(alertHits)) {
                    alertHits.forEach(h => {
                        if (!hitMap.has(h.article_id)) hitMap.set(h.article_id, []);
                        hitMap.get(h.article_id).push({
                            alert_name: h.alert_name,
                            matched_word: h.matched_text
                        });
                    });
                }

                articles.forEach(a => {
                    if (!a.matched_alerts) a.matched_alerts = [];
                    if (hitMap.has(a.id)) {
                        const existingWords = new Set(a.matched_alerts.map(m => (m.matched_word || '').toLowerCase()));
                        hitMap.get(a.id).forEach(h => {
                            if (!existingWords.has((h.matched_word || '').toLowerCase())) {
                                a.matched_alerts.push(h);
                                existingWords.add((h.matched_word || '').toLowerCase());
                            }
                        });
                    }
                });

                currentGlobeCountryArticles = articles;
                renderRadarActiveWords();
                renderFilteredGlobeArticles();

            } catch (e) {
                console.error(e);
                container.innerHTML = '<div class="text-center py-12 text-red-500 text-xs">Chyba načítania.</div>';
            }
        }

        function setGlobePeriod(p) {
            globePeriod = p;
            ['1h', '6h', '24h', 'all'].forEach(k => {
                const el = document.getElementById(`gp-${k}`);
                if (el) {
                    el.classList.remove('bg-blue-600', 'text-white', 'font-bold');
                    el.classList.add('text-gray-300');
                }
            });
            const activeEl = document.getElementById(`gp-${p}`);
            if (activeEl) {
                activeEl.classList.add('bg-blue-600', 'text-white', 'font-bold');
                activeEl.classList.remove('text-gray-300');
            }
            initOrUpdateGlobe();
        }

        function applyGlobeKeyword() {
            const val = document.getElementById('globe-keyword-input').value.trim();
            if (!val) return;
            globeQuery = val;
            const badge = document.getElementById('globe-active-word-badge');
            badge.classList.remove('hidden');
            document.getElementById('globe-active-word-text').innerText = val;
            initOrUpdateGlobe();
        }

        function clearGlobeKeyword() {
            globeQuery = '';
            document.getElementById('globe-keyword-input').value = '';
            document.getElementById('globe-active-word-badge').classList.add('hidden');
            initOrUpdateGlobe();
        }

        function resetFilters() {
            currentCountry = '';
            currentPeriod = 'all';
            currentQuery = '';
            document.getElementById('keyword-input').value = '';
            document.getElementById('keyword-result').classList.add('hidden');
            document.querySelectorAll('.time-pill').forEach(el => el.classList.remove('active'));
            document.getElementById('p-all').classList.add('active');
            updateBadge();
            loadCountries();
            loadStats();
            loadArticles('', '');
        }

        function refreshData() {
            loadStats();
            loadCountries();
            loadArticles(currentCountry, currentQuery);
            loadAlertsOverview();
        }

        // Init
        refreshData();
    
        let allFavoritesList = [];

        function updateModalFavButton(isFav) {
            const btn = document.getElementById('modal-fav-btn');
            const icon = document.getElementById('modal-fav-icon');
            const text = document.getElementById('modal-fav-text');
            if (!btn) return;
            if (isFav) {
                btn.className = 'px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 border bg-amber-950/80 border-amber-600 text-amber-300 hover:bg-amber-900';
                icon.innerText = '★';
                text.innerText = 'Uložené v knižnici';
            } else {
                btn.className = 'px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1.5 border bg-gray-900 border-gray-700 text-gray-300 hover:text-amber-300 hover:border-amber-600';
                icon.innerText = '☆';
                text.innerText = 'Uložiť do knižnice';
            }
        }

        async function toggleModalFavorite() {
            if (!currentArticleData) return;
            const aid = currentArticleData.id;
            const willBeFav = !currentArticleData.is_favorite;
            try {
                if (willBeFav) {
                    await fetch('/api/favorites', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ article_id: aid })
                    });
                } else {
                    await fetch(`/api/favorites/${aid}`, { method: 'DELETE' });
                }
                currentArticleData.is_favorite = willBeFav ? 1 : 0;
                updateModalFavButton(currentArticleData.is_favorite);
                loadStats();
                const favView = document.getElementById('view-favorites');
                if (favView && !favView.classList.contains('hidden')) {
                    loadFavorites();
                }
            } catch (err) {
                console.error('Error toggling favorite from modal:', err);
            }
        }

        async function toggleCardFavorite(aid, btnEl) {
            const isCurrentlyFav = btnEl.innerText.trim() === '★';
            const willBeFav = !isCurrentlyFav;
            try {
                if (willBeFav) {
                    await fetch('/api/favorites', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ article_id: aid })
                    });
                    btnEl.innerText = '★';
                    btnEl.className = 'p-1 rounded hover:bg-gray-800 transition text-amber-400';
                    btnEl.title = 'Odstrániť z knižnice';
                } else {
                    await fetch(`/api/favorites/${aid}`, { method: 'DELETE' });
                    btnEl.innerText = '☆';
                    btnEl.className = 'p-1 rounded hover:bg-gray-800 transition text-gray-500 hover:text-amber-400';
                    btnEl.title = 'Uložiť do knižnice';
                }
                loadStats();
                const favView = document.getElementById('view-favorites');
                if (favView && !favView.classList.contains('hidden')) {
                    loadFavorites();
                }
            } catch (err) {
                console.error('Error toggling card favorite:', err);
            }
        }

        async function loadFavorites() {
            const container = document.getElementById('favorites-container');
            const badge = document.getElementById('favorites-total-badge');
            if (!container) return;
            container.innerHTML = '<div class="col-span-2 text-center py-16 text-gray-500 text-xs flex items-center justify-center gap-2"><span class="w-4 h-4 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></span> Načítavam knižnicu...</div>';

            try {
                const res = await fetch('/api/favorites?limit=200');
                allFavoritesList = await res.json();
                if (badge) badge.innerText = `${allFavoritesList.length} uložených`;
                renderFavoritesCards(allFavoritesList);
            } catch (err) {
                console.error(err);
                container.innerHTML = '<div class="col-span-2 text-center py-12 text-red-400 text-xs">Chyba načítania knižnice.</div>';
            }
        }

        function filterFavoritesList() {
            const query = (document.getElementById('favorites-search')?.value || '').toLowerCase().trim();
            if (!query) {
                renderFavoritesCards(allFavoritesList);
                return;
            }
            const filtered = allFavoritesList.filter(a => {
                return (a.title_sk && a.title_sk.toLowerCase().includes(query)) ||
                       (a.title_orig && a.title_orig.toLowerCase().includes(query)) ||
                       (a.title_en && a.title_en.toLowerCase().includes(query)) ||
                       (a.media_name && a.media_name.toLowerCase().includes(query)) ||
                       (a.country_name && a.country_name.toLowerCase().includes(query)) ||
                       (a.perex_orig && a.perex_orig.toLowerCase().includes(query));
            });
            renderFavoritesCards(filtered);
        }

        function renderFavoritesCards(articles) {
            const container = document.getElementById('favorites-container');
            if (!container) return;
            if (articles.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-16 text-gray-500 text-xs bg-gray-950/40 rounded-xl border border-gray-800/60 p-8">
                        <div class="text-3xl mb-2">⭐</div>
                        <div class="text-sm font-semibold text-gray-300 mb-1">Žiadne články v knižnici</div>
                        <div>Označte zaujímavé články hviezdičkou v živom toku alebo priamo v detaile správy.</div>
                    </div>
                `;
                return;
            }

            let html = '';
            articles.forEach(a => {
                const dateObj = new Date(a.saved_at || a.published_at || a.scraped_at);
                const timeStr = dateObj.toLocaleDateString([], {day:'2-digit', month:'2-digit'}) + ' ' + dateObj.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

                html += `
                    <div onclick="openArticleModal(${a.id})" class="glass-panel p-4 rounded-xl hover:border-amber-500/60 hover:bg-gray-900/90 transition cursor-pointer relative group">
                        <div class="flex items-center justify-between text-xs text-gray-400 mb-1.5">
                            <span class="font-medium text-amber-400 flex items-center gap-1.5">
                                ${(a.url && a.url.includes('t.me')) || (a.media_name && a.media_name.includes('TG')) ? '<span class="px-1 py-0.2 bg-cyan-950 text-cyan-300 border border-cyan-800 rounded text-[9px] font-bold">✈️ TG</span>' : ''}
                                <span>${a.media_name} · ${a.country_name}</span>
                            </span>
                            <div class="flex items-center gap-2">
                                <button onclick="event.stopPropagation(); removeFavoriteItem(${a.id})" class="text-amber-400 hover:text-red-400 p-1 rounded transition text-sm" title="Odstrániť z knižnice">
                                    ★
                                </button>
                                <span class="text-[11px] text-gray-500">${timeStr}</span>
                            </div>
                        </div>

                        <!-- Titulok v slovenčine / originál -->
                        <div class="text-sm font-semibold text-white mb-2 leading-snug">
                            ${a.title_sk || a.title_orig}
                        </div>

                        ${a.title_sk && a.title_sk !== a.title_orig ? `
                            <div class="text-xs text-gray-400 line-clamp-1 italic mb-2">
                                Orig: ${a.title_orig}
                            </div>
                        ` : ''}

                        ${a.perex_orig ? `<p class="text-xs text-gray-400 line-clamp-2 mb-2">${a.perex_orig}</p>` : ''}

                        <div class="mt-2.5 flex items-center justify-between text-[11px] text-gray-500 border-t border-gray-800/80 pt-2">
                            <span class="text-amber-400/90 font-medium">📄 Plný slovenský prepis</span>
                            <span class="text-gray-400 group-hover:text-amber-300 transition">Čítať →</span>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        async function removeFavoriteItem(aid) {
            try {
                await fetch(`/api/favorites/${aid}`, { method: 'DELETE' });
                allFavoritesList = allFavoritesList.filter(a => a.id !== aid);
                const badge = document.getElementById('favorites-total-badge');
                if (badge) badge.innerText = `${allFavoritesList.length} uložených`;
                filterFavoritesList();
                loadStats();
            } catch (err) {
                console.error('Error removing favorite:', err);
            }
        }

        function exportFavoritesCSV() {
            if (!allFavoritesList || allFavoritesList.length === 0) {
                alert('V knižnici sa nenachádzajú žiadne články na export.');
                return;
            }
            let csv = 'ID,Médiá,Krajina,Titulok_SK,Titulok_Orig,URL,Uložené\n';
            allFavoritesList.forEach(a => {
                const clean = (str) => '"' + (str || '').replace(/"/g, '""').replace(/\n/g, ' ') + '"';
                csv += `${a.id},${clean(a.media_name)},${clean(a.country_name)},${clean(a.title_sk)},${clean(a.title_orig)},${clean(a.url)},${clean(a.saved_at)}\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', `spravodajsky_tep_kniznica_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

    </script>
