        function renderModalText() {
            if (!currentArticleData) return;
            const body = document.getElementById('modal-body');

            let rawText = '';
            if (currentModalLang === 'sk') {
                rawText = currentArticleData.full_text_sk || currentArticleData.full_text_orig || '';
            } else if (currentModalLang === 'en') {
                rawText = currentArticleData.full_text_en || currentArticleData.full_text_orig || '';
            } else {
                rawText = currentArticleData.full_text_orig || currentArticleData.perex_orig || '';
            }

            // Escape HTML
            rawText = rawText.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

            // Zhromaždiť radar slová pre zvýraznenie
            const patterns = [];
            if (currentArticleData.active_radar_patterns) {
                currentArticleData.active_radar_patterns.forEach(p => {
                    p.query_pattern.split('|').forEach(word => {
                        const w = word.trim();
                        if (w.length > 2) patterns.push(w);
                    });
                });
            }
            if (currentQuery && currentQuery.length > 2) {
                patterns.push(currentQuery);
            }

            const paragraphs = rawText.split(/\n+/);
            const processedParagraphs = paragraphs.map(p => {
                let content = p;
                patterns.forEach(pat => {
                    const regex = new RegExp(`(${pat})`, 'gi');
                    content = content.replace(regex, `<span class="radar-highlight">$1</span>`);
                });
                return `<p class="mb-3.5 text-gray-200 leading-relaxed text-[13.5px]">${content}</p>`;
            });

            body.innerHTML = `
                <div class="prose max-w-none">
                    <div class="mb-4 p-3 bg-gray-900/80 rounded-xl border border-gray-800 text-xs text-gray-400 flex justify-between items-center">
                        <span><strong>Dĺžka textu:</strong> ${rawText.length} znakov (${paragraphs.length} odsekov)</span>
                        <span class="text-blue-400 font-mono">${currentModalLang.toUpperCase()} REŽIM</span>
                    </div>
                    <div>
                        ${processedParagraphs.join('')}
                    </div>
                </div>
            `;
        }

