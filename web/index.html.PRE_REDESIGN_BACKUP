                        currentPulseMarkers.push({
                            id: `pulse-${c.iso_code}`,
                            iso: c.iso_code,
                            location: [c.lat, c.lon],
                            delay: (markerIndex % 4) * 0.4,
                            name: c.name_sk,
                            count: c.article_count
                        });
                        markerIndex++;
                    }
                });

                document.getElementById('globe-markers-count').innerText = currentPulseMarkers.length;

                // Vykresli najsilnejšie pulzy v bočnom paneli
                countries.slice(0, 12).forEach(c => {
                    if (c.article_count > 0) {
                        pillsHtml += `
                            <button onclick="rotateGlobeTo('${c.iso_code}', ${c.lat}, ${c.lon}, '${c.name_sk}', ${c.article_count})" 
                                    class="px-2.5 py-1 rounded bg-gray-900/90 hover:bg-red-950 border border-gray-800 hover:border-red-700 text-xs text-gray-200 flex items-center gap-1.5 transition">
                                <span class="w-2 h-2 rounded-full bg-red-600 inline-block animate-pulse"></span>
                                <span>${c.name_sk}</span>
                                <span class="bg-red-950 text-red-300 border border-red-800 px-1.5 py-0.2 rounded font-mono font-bold text-[10px]">${c.article_count}</span>
                            </button>
                        `;
                    }
                });
                topPillsContainer.innerHTML = pillsHtml || '<div class="text-xs text-gray-500">Žiadne aktívne správy.</div>';

                // Render HTML vrstvy pulzujúcich tmavočervených bodov (21st.dev template)
                renderPulseMarkersHTML();

                // Ak Cobe už existuje, len aktualizujeme jeho markers
                if (cobeGlobe) {
                    cobeGlobe.update({
                        markers: currentPulseMarkers.map(m => ({ location: m.location, size: m.size || 0.045, id: m.id }))
                    });
                }

                // Inicializácia Cobe Canvasu presne podľa 21st.dev šablóny
                if (!cobeGlobe && window.createGlobe) {
                    const canvas = document.getElementById('cobe-canvas');
                    const width = canvas.parentElement ? canvas.parentElement.offsetWidth : 520;

                    // Pointer / Drag listener presne podľa šablóny
                    canvas.addEventListener('pointerdown', (e) => {
                        cobePointerInteracting = { x: e.clientX, y: e.clientY };
                        canvas.style.cursor = 'grabbing';
                        isGlobePaused = true;
                    });

                    window.addEventListener('pointerup', () => {
                        if (cobePointerInteracting !== null) {
                            cobePhiOffset += cobeDragOffset.phi;
                            cobeThetaOffset += cobeDragOffset.theta;
                            cobeDragOffset = { phi: 0, theta: 0 };
                        }
                        cobePointerInteracting = null;
                        canvas.style.cursor = 'grab';
                        const btnText = document.getElementById('btn-globe-pause-text');
                        if (btnText && btnText.innerText === 'Zastaviť rotáciu') {
                            isGlobePaused = false;
                        }
                    });

                    window.addEventListener('pointermove', (e) => {
                        if (cobePointerInteracting !== null) {
                            cobeDragOffset = {
                                phi: (e.clientX - cobePointerInteracting.x) / 300,
                                theta: (e.clientY - cobePointerInteracting.y) / 1000,
                            };
                        }
                    }, { passive: true });

                    // Konfigurácia presne z 21st.dev s tmavočervenými bodkami a zreteľnou pevninou
                    cobeGlobe = window.createGlobe(canvas, {
                        devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
                        width: width * 2,
                        height: width * 2,
                        phi: 0,
                        theta: 0.2,
                        dark: 1,
                        diffuse: 1.5,
                        mapSamples: 16000,
                        mapBrightness: 10,
                        baseColor: [0.55, 0.55, 0.55], // Jasne zreteľná pevnina/mapa ako v šablóne
                        markerColor: [0.85, 0.1, 0.1], // Tmavočervené pulzujúce body
                        glowColor: [0.05, 0.05, 0.05],
                        markerElevation: 0,
                        markers: currentPulseMarkers.map(m => ({ location: m.location, size: m.size || 0.045, id: m.id })),
                        arcs: [],
                        arcColor: [0.85, 0.1, 0.1],
                        arcWidth: 0.5,
                        arcHeight: 0.25,
                        opacity: 0.85,
                    });

                    function animate() {
                        if (!isGlobePaused) cobePhi += 0.003;
                        const currentPhi = cobePhi + cobePhiOffset + cobeDragOffset.phi;
                        const currentTheta = 0.2 + cobeThetaOffset + cobeDragOffset.theta;

                        if (cobeGlobe) {
                            cobeGlobe.update({
                                phi: currentPhi,
                                theta: currentTheta,
                                markers: currentPulseMarkers.map(m => ({ location: m.location, size: m.size || 0.045, id: m.id }))
                            });
                        }
                        updatePulseMarkersPosition(currentPhi, currentTheta);
                        cobeAnimationId = requestAnimationFrame(animate);
                    }

                    animate();
                    setTimeout(() => { if (canvas) canvas.style.opacity = "1"; }, 150);
                }

                if (countries.length > 0 && countries[0].article_count > 0) {
                    loadGlobeCountryArticles(countries[0].iso_code, countries[0].name_sk, countries[0].article_count);
                }

            } catch (e) { console.error('Globe error:', e); }
        }

        function renderPulseMarkersHTML() {
            const overlay = document.getElementById('cobe-html-overlay');
            if (!overlay) return;
            let html = '';
            currentPulseMarkers.forEach(m => {
                html += `
                    <div id="cobe-pulse-${m.id}" 
                         class="cobe-pulse-marker group" 
                         style="opacity: 0;"
                         onclick="rotateGlobeTo('${m.iso}', ${m.location[0]}, ${m.location[1]}, '${m.name}', ${m.count})"
                         title="📍 ${m.name}: ${m.count} správ (Klikni pre detail a otočenie)">
                        <span class="cobe-ring-1" style="animation-delay: ${m.delay}s;"></span>
                        <span class="cobe-ring-2" style="animation-delay: ${m.delay + 0.5}s;"></span>
                        <span class="cobe-core-dot"></span>
                        <span class="absolute bottom-full mb-1 hidden group-hover:flex items-center gap-1 bg-gray-950/95 text-white text-[10px] font-bold px-2 py-0.5 rounded border border-red-700 whitespace-nowrap shadow-xl shadow-black z-50">
                            <span>${m.name}</span>
                            <span class="text-red-400 font-mono">${m.count}</span>
                        </span>
