<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spravodajský Tep Sveta | Global News Pulse</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Cobe 3D Globe Library -->
    <script type="module">
        import createGlobe from "https://esm.sh/cobe";
        window.createGlobe = createGlobe;
    </script>
    <style>
        body { background-color: #0b0f19; color: #f3f4f6; }
        .glass-panel { background: rgba(17, 24, 39, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .active-tab { background-color: #2563eb; color: #ffffff; font-weight: bold; }
        .time-pill.active { background-color: #3b82f6; color: white; border-color: #60a5fa; }
        .modal-lang-tab.active { background-color: #1e3a8a; color: #93c5fd; border-bottom: 2px solid #60a5fa; font-weight: bold; }
        
        /* 21st.dev Cobe Globe Pulse Keyframes - Dark Red */
        @keyframes pulse-expand {
            0% { transform: scale(0.3); opacity: 0.9; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        .cobe-pulse-marker {
            position: absolute;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: auto;
            cursor: pointer;
            transform: translate(-50%, -50%);
            transition: opacity 0.3s ease, transform 0.2s ease;
        }
        .cobe-pulse-marker:hover {
            transform: translate(-50%, -50%) scale(1.3);
            z-index: 50;
        }
        .cobe-ring-1 {
            position: absolute; inset: 0; border: 2px solid #ef4444; border-radius: 50%; opacity: 0;
            animation: pulse-expand 2s ease-out infinite;
        }
        .cobe-ring-2 {
            position: absolute; inset: 0; border: 2px solid #ef4444; border-radius: 50%; opacity: 0;
            animation: pulse-expand 2s ease-out infinite 0.6s;
        }
        .cobe-core-dot {
            width: 10px; height: 10px; background-color: #ef4444; border-radius: 50%;
            box-shadow: 0 0 0 2px #0a0a0a, 0 0 0 4px #dc2626, 0 0 16px rgba(239, 68, 68, 1);
        }

        /* Zvýraznenie kľúčových slov z radaru */
        .radar-highlight {
            background-color: rgba(220, 38, 38, 0.35);
            color: #fecaca;
            font-weight: 700;
            padding: 1px 4px;
            border-radius: 4px;
            border: 1px solid rgba(239, 68, 68, 0.6);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans">

    <!-- Top Header -->
    <header class="glass-panel sticky top-0 z-40 px-6 py-3.5 flex flex-wrap justify-between items-center border-b border-gray-800">
        <div class="flex items-center space-x-3">
            <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <h1 class="text-xl font-bold tracking-wider uppercase text-white flex items-center gap-2">
                <span>🌍 Spravodajský Tep Sveta</span>
                <span class="text-xs bg-blue-900/60 text-blue-300 px-2 py-0.5 rounded border border-blue-700">TERMINAL v1.3</span>
            </h1>
        </div>

        <!-- Rýchle Navigačné Záložky -->
        <div class="flex items-center bg-gray-900/90 p-1 rounded-lg border border-gray-800 text-xs">
            <button onclick="switchView('feed')" id="tab-feed" class="px-3 py-1.5 rounded-md active-tab transition">📰 Živý Tok & Filtre</button>
            <button onclick="switchView('globe')" id="tab-globe" class="px-3 py-1.5 rounded-md text-cyan-400 hover:text-white transition flex items-center gap-1.5">
                <span>🌐 Live Globe Pulse</span>
                <span class="bg-cyan-950 text-cyan-300 border border-cyan-800 px-1.5 py-0.2 rounded text-[10px] font-mono animate-pulse">3D LIVE</span>
            </button>
            <button onclick="switchView('favorites')" id="tab-favorites" class="px-3 py-1.5 rounded-md text-gray-400 hover:text-white transition flex items-center gap-1.5">
                <span>⭐ Knižnica</span>
                <span id="badge-favorites-count" class="bg-amber-950 text-amber-300 border border-amber-800 px-1.5 py-0.2 rounded text-[10px] font-bold">0</span>
            </button>
            <button onclick="switchView('alerts')" id="tab-alerts" class="px-3 py-1.5 rounded-md text-gray-400 hover:text-white transition flex items-center gap-1.5">
                <span>🚨 Ovládací Panel Alarmov</span>
                <span id="badge-alerts-count" class="bg-red-900/80 text-red-200 px-1.5 py-0.2 rounded text-[10px]">0</span>
            </button>
            <button onclick="switchView('sources')" id="tab-sources" class="px-3 py-1.5 rounded-md text-gray-400 hover:text-white transition flex items-center gap-1.5">
                <span>📡 Zdroje & Webstránky</span>
                <span id="badge-sources-count" class="bg-blue-900/80 text-blue-200 px-1.5 py-0.2 rounded text-[10px]">0</span>
            </button>
        </div>

        <div class="flex items-center gap-5 text-xs text-gray-400">
            <div>Článkov: <span id="stat-articles" class="font-bold text-white">0</span></div>
            <div>Médií: <span id="stat-media" class="font-bold text-white">0</span></div>
            <div>Alarmy: <span id="stat-alerts" class="font-bold text-amber-400">0</span></div>
            <button onclick="refreshData()" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-500 text-white rounded transition">🔄 Obnoviť</button>
        </div>
    </header>

    <!-- VIEW 1: ŽIVÝ TOK A ANALÝZA -->
    <main id="view-feed" class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-4 gap-6">

        <!-- Ľavý stĺpec: Časové obdobie, Hľadanie slova, Krajiny -->
        <div class="lg:col-span-1 space-y-5">
            
            <!-- ČASOVÝ OVLÁDACÍ PANEL -->
            <div class="glass-panel p-4 rounded-xl">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2.5">⏱️ Časové Obdobie</h3>
                <div class="grid grid-cols-3 gap-1.5 text-xs">
                    <button onclick="setPeriod('1h')" id="p-1h" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center transition">1 hodina</button>
                    <button onclick="setPeriod('6h')" id="p-6h" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center transition">6 hodín</button>
                    <button onclick="setPeriod('24h')" id="p-24h" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center transition">24 hodín</button>
                    <button onclick="setPeriod('7d')" id="p-7d" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center transition">7 dní</button>
                    <button onclick="setPeriod('30d')" id="p-30d" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center transition">30 dní</button>
                    <button onclick="setPeriod('all')" id="p-all" class="time-pill py-1.5 px-2 rounded bg-gray-900 border border-gray-800 hover:bg-gray-800 text-center active transition">Všetko</button>
                </div>
            </div>

            <!-- ANALÝZA FREKVENCIE SLOVA -->
            <div class="glass-panel p-4 rounded-xl">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">🔍 Frekvencia Slova (Tep)</h3>
                    <span class="text-[10px] text-blue-400 bg-blue-950 px-1.5 py-0.5 rounded border border-blue-900">Multilingual AI</span>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="keyword-input" placeholder="Zlato, ropa, Boeing..." 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-blue-500">
                    <button onclick="analyzeKeyword()" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 font-semibold text-white rounded-lg text-xs">Hľadať</button>
                </div>
                <div id="keyword-result" class="mt-3 hidden p-3 bg-gray-900/90 rounded-lg border border-gray-800">
                    <div class="flex justify-between items-baseline">
                        <span class="text-xs text-gray-400">Výskyt vo zvolenom čase:</span>
                        <span class="text-xl font-bold text-amber-400" id="kw-total">0</span>
                    </div>
                    <div class="mt-1 text-[11px] text-gray-500" id="kw-expanded"></div>
                    <div class="mt-2 text-xs text-gray-300" id="kw-breakdown"></div>
                </div>
            </div>

            <!-- ZOZNAM KRAJÍN -->
            <div class="glass-panel p-4 rounded-xl flex flex-col h-[480px]">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2.5">📍 Krajiny</h3>
                <div class="flex-1 overflow-y-auto space-y-1 pr-1.5" id="country-list">
                    <button onclick="filterCountry('')" class="w-full text-left px-3 py-1.5 rounded-lg bg-gray-800/80 hover:bg-gray-700 text-xs flex justify-between">
                        <span>🌐 Všetky krajiny</span>
                    </button>
                </div>
            </div>

        </div>

        <!-- Stredný stĺpec: ŽIVÝ TOK SPRÁV -->
        <div class="lg:col-span-2 space-y-4">
            <div class="glass-panel p-3.5 rounded-xl flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <h2 class="text-base font-bold text-white" id="feed-title">Globálny Tok Článkov</h2>
                    <span class="text-xs bg-gray-800 text-gray-400 px-2 py-0.5 rounded" id="current-filter-badge">Všetky krajiny · Všetko</span>
                </div>
                <button onclick="resetFilters()" class="text-xs text-blue-400 hover:underline">Zrušiť filtre</button>
            </div>

            <!-- Zoznam článkov -->
            <div class="space-y-3 overflow-y-auto max-h-[820px] pr-2" id="articles-container">
                <div class="text-center py-12 text-gray-500 text-sm">Načítavam články...</div>
            </div>
        </div>

        <!-- Pravý stĺpec: RADAR NAJNOVŠÍCH VÝSTRAH -->
        <div class="lg:col-span-1 space-y-5">
            <div class="glass-panel p-4 rounded-xl">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-red-400 flex items-center gap-1.5">
                        <span>🚨 Radar Posledných Zásahov</span>
                    </h3>
                    <button onclick="switchView('alerts')" class="text-[11px] text-gray-400 hover:text-white underline">Spravovať</button>
                </div>
                <div class="space-y-2.5 overflow-y-auto max-h-[500px] pr-1" id="alarm-hits-container">
                    <div class="text-xs text-gray-500">Žiadne nové alarmy.</div>
                </div>
            </div>
        </div>

    </main>

    <!-- VIEW 2: OVLÁDACÍ PANEL ALARMOV A SLEDOVAČOV -->
    <main id="view-alerts" class="flex-1 p-6 max-w-6xl mx-auto w-full hidden space-y-6">
        
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span>🚨 Ovládací Panel Alarmov & Sledovačov</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">Sledovanie funguje automaticky vo všetkých svetových jazykoch (SK, EN, RU, ZH, DE, AR...).</p>
            </div>
            <button onclick="switchView('feed')" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs rounded-lg transition">← Späť do správ</button>
        </div>

        <!-- Form pre nový alarm -->
        <div class="glass-panel p-5 rounded-xl border border-blue-900/40">
            <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                <span>➕ Pridať Nový Sledovač / Alarm</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Názov alarmu</label>
                    <input type="text" id="new-alert-name" placeholder="napr. Pád lietadla, Zlato, Fúzia, Nvidia" 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Kľúčové slovo (systém ho sám preloží do sveta)</label>
                    <input type="text" id="new-alert-pattern" placeholder="napr. zlato alebo pád lietadla" 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div class="flex items-end gap-2">
                    <button onclick="createAlert()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 font-semibold text-white rounded-lg text-xs transition">
                        💾 Vytvoriť a spustiť radar
                    </button>
                </div>
            </div>
        </div>

        <!-- Zoznam existujúcich alarmov -->
        <div class="glass-panel p-5 rounded-xl">
            <h3 class="text-sm font-bold text-white mb-4">📋 Aktívne Sledovače</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="text-[11px] uppercase bg-gray-900/80 text-gray-400 border-b border-gray-800">
                        <tr>
                            <th class="py-2.5 px-3">Názov</th>
                            <th class="py-2.5 px-3">Kľúčový Regex / Slová</th>
                            <th class="py-2.5 px-3">Zásahy (Hits)</th>
                            <th class="py-2.5 px-3">Stav</th>
                            <th class="py-2.5 px-3 text-right">Akcia</th>
                        </tr>
                    </thead>
                    <tbody id="alerts-table-body" class="divide-y divide-gray-800">
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Detailná história zásahov -->
        <div class="glass-panel p-5 rounded-xl">
            <h3 class="text-sm font-bold text-white mb-3">🕒 Kompletná História Zásahov Alarmov</h3>
            <div class="space-y-2 max-h-[400px] overflow-y-auto pr-1" id="full-alert-hits">
            </div>
        </div>

    </main>

    
    <!-- VIEW: KNIŽNICA & OBĽÚBENÉ (VIEW-FAVORITES) -->
    <main id="view-favorites" class="flex-1 p-6 max-w-6xl mx-auto w-full hidden space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-800/80 pb-4">
            <div>
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="text-amber-400">⭐</span>
                    <span>Knižnica Uložených Článkov</span>
                    <span id="favorites-total-badge" class="text-xs bg-amber-950/80 text-amber-300 px-2.5 py-0.5 rounded border border-amber-800 font-mono font-bold">0 uložených</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">Vaša osobná zbierka dôležitých správ a analýz. Synchronizované so serverom naprieč všetkými zariadeniami.</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="relative">
                    <input type="text" id="favorites-search" oninput="filterFavoritesList()" placeholder="Hľadať v knižnici..." class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-1.5 text-xs text-white placeholder-gray-500 w-48 sm:w-64 focus:outline-none focus:border-amber-500">
                    <span class="absolute right-2.5 top-2 text-gray-500 text-xs pointer-events-none">🔍</span>
                </div>
                <button onclick="exportFavoritesCSV()" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-amber-300 border border-amber-900/60 text-xs rounded-lg transition flex items-center gap-1.5">
                    <span>📥 Export CSV</span>
                </button>
                <button onclick="switchView('feed')" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs rounded-lg transition">← Späť do toku</button>
            </div>
        </div>

        <div id="favorites-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Dynamicky naplnené články knižnice -->
        </div>
    </main>

    <!-- VIEW 3: SPRÁVA ZDROJOV A NOVINÁRSKYCH PORTÁLOV -->
    <main id="view-sources" class="flex-1 p-6 max-w-6xl mx-auto w-full hidden space-y-6">
        
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span>📡 Správa Zdrojov a Webstránok</span>
                    <span id="sources-header-country" class="text-xs bg-blue-900/60 text-blue-300 px-2.5 py-0.5 rounded border border-blue-700">Všetky krajiny</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">Zoznam monitorovaných médií. Môžeš pridať nový portál s RSS feedom alebo odstrániť nepotrebný zdroj.</p>
            </div>
            <div class="flex items-center gap-3">
                <select id="sources-filter-country" onchange="filterSourcesByCountry()" class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-1.5 text-xs text-white">
                    <option value="">🌐 Všetky krajiny</option>
                </select>
                <button onclick="switchView('feed')" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-200 text-xs rounded-lg transition">← Späť do správ</button>
            </div>
        </div>

        <!-- Formulár na pridanie nového zdroja -->
        <div class="glass-panel p-5 rounded-xl border border-blue-900/40">
            <h3 class="text-sm font-bold text-white mb-3 flex items-center justify-between">
                <span class="flex items-center gap-2">
                    <span>➕ Pridať Nový Webový Portál alebo Telegram Kanál</span>
                </span>
                <span class="text-[11px] text-cyan-400 bg-cyan-950/80 px-2.5 py-0.5 rounded border border-cyan-800">
                    💡 Pre Telegram stačí zadať napr. @bbbreaking alebo t.me/disclosetv
                </span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Krajina</label>
                    <select id="new-media-country" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white">
                        <!-- Naplní JS -->
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Typ zdroja</label>
                    <select id="new-media-type" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white">
                        <option value="general">🌐 Web Noviny / Portál (RSS)</option>
                        <option value="telegram">✈️ Telegram Kanál</option>
                        <option value="business">📈 Finančné / Burzové</option>
                        <option value="tech">🤖 AI & Tech</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Názov kanála / novín</label>
                    <input type="text" id="new-media-name" placeholder="napr. Disclose.tv, Pravda" 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Web URL (voliteľné pri TG)</label>
                    <input type="url" id="new-media-web" placeholder="https://..." 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">RSS URL alebo @TelegramHandle</label>
                    <input type="text" id="new-media-rss" placeholder="@kanal alebo https://.../rss" 
                           class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div class="flex items-end">
                    <button onclick="createMedia()" class="w-full py-2 bg-blue-600 hover:bg-blue-500 font-semibold text-white rounded-lg text-xs transition">
                        💾 Pridať zdroj
                    </button>
                </div>
            </div>
        </div>

        <!-- Zoznam zdrojov -->
        <div class="glass-panel p-5 rounded-xl">
            <h3 class="text-sm font-bold text-white mb-4 flex justify-between items-center">
                <span>📋 Zoznam Portálov v Danej Krajine</span>
                <span class="text-xs text-gray-400" id="sources-count-label">Celkovo 0 zdrojov</span>
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="text-[11px] uppercase bg-gray-900/80 text-gray-400 border-b border-gray-800">
                        <tr>
                            <th class="py-2.5 px-3">Krajina</th>
                            <th class="py-2.5 px-3">Médiom / Portál</th>
                            <th class="py-2.5 px-3">Kategória</th>
                            <th class="py-2.5 px-3">RSS Feed URL</th>
                            <th class="py-2.5 px-3">Stiahnutých článkov</th>
                            <th class="py-2.5 px-3 text-right">Akcia</th>
                        </tr>
                    </thead>
                    <tbody id="sources-table-body" class="divide-y divide-gray-800">
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- VIEW 4: LIVE GLOBE PULSE 3D -->
    <main id="view-globe" class="flex-1 p-6 max-w-7xl mx-auto w-full hidden flex flex-col space-y-5">
        
        <!-- Header & Ovládanie Glóbusu -->
        <div class="glass-panel p-4 rounded-xl flex flex-wrap justify-between items-center gap-4">
            <div>
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span>🌐 Live 3D Globe Pulse</span>
                    <span class="text-xs bg-cyan-900/60 text-cyan-300 border border-cyan-700 px-2.5 py-0.5 rounded font-mono">COBE ENGINE</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">Interaktívna 3D planéta s pulzujúcimi spravodajskými bodmi. Otáčaj myšou, sleduj frekvenciu tém a klikni na pulzujúcu krajinu.</p>
            </div>

            <!-- Filtre Glóbusu: Čas a Kľúčové slovo -->
            <div class="flex flex-wrap items-center gap-3 text-xs">
                <!-- Tlačidlo Pozastaviť / Spustiť rotáciu -->
