            overlay.innerHTML = html;
        }

        function updatePulseMarkersPosition(phi, theta) {
            const overlay = document.getElementById('cobe-html-overlay');
            if (!overlay || !currentPulseMarkers.length) return;
            const size = overlay.offsetWidth;
            const radius = size / 2;

            currentPulseMarkers.forEach(m => {
                const el = document.getElementById(`cobe-pulse-${m.id}`);
                if (!el) return;

                const lat = (m.location[0] * Math.PI) / 180;
                const lon = (m.location[1] * Math.PI) / 180 - Math.PI;

                // 3D smerový vektor bodu presne podľa funkcie _([lat, lon]) z Cobe:
                // _([lat, lon]): x = -sin(lat)*sin(lon), y = cos(lat), z = sin(lat)*cos(lon)
                // Tu Math.sin(lat) je cos(zemepisnej sirky) a Math.cos(lat) je sin(zemepisnej sirky) v beznom zmysle:
                // Cobe pouziva: v = lat*PI/180 (od rovníka 0..PI/2), s = sin(v), ce = cos(v)
                const v = lat;
                const e = lon;
                const s = Math.sin(v);
                const ce = Math.cos(v);
                const se_e = Math.sin(e);
                const ce_e = Math.cos(e);

                // Bod na sfére pred rotáciou [x0, y0, z0]
                const x0 = -s * se_e;
                const y0 = ce;
                const z0 = s * ce_e;

                // Transformácia shaderu v Cobe:
                // C = cos(phi)*x0 + sin(phi)*z0
                // F = sin(phi)*sin(theta)*x0 + cos(theta)*y0 - cos(phi)*sin(theta)*z0
                // visible = -sin(phi)*cos(theta)*x0 + sin(theta)*y0 + cos(phi)*cos(theta)*z0 >= 0
                const cosPhi = Math.cos(phi);
                const sinPhi = Math.sin(phi);
                const cosTheta = Math.cos(theta);
                const sinTheta = Math.sin(theta);

                const C = cosPhi * x0 + sinPhi * z0;
                const F = sinPhi * sinTheta * x0 + cosTheta * y0 - cosPhi * sinTheta * z0;
                const visible = -sinPhi * cosTheta * x0 + sinTheta * y0 + cosPhi * cosTheta * z0;

                // Ak je bod na privrátenej strane glóbusu k pozorovateľovi:
                if (visible >= 0.05 || (C * C + F * F) < 0.64) {
                    const screenX = radius + C * radius;
                    const screenY = radius - F * radius;
                    el.style.left = `${screenX}px`;
                    el.style.top = `${screenY}px`;
                    el.style.opacity = visible >= 0.05 ? "1" : "0.3";
                } else {
                    el.style.opacity = "0";
                }
            });
        }

        function rotateGlobeTo(iso, lat, lon, name, count) {
            // Presný prepočet zemepisnej dĺžky na uhol phi a theta pre Cobe
            // Shader v Cobe: _([lat, lon]) -> [-sin(lat)*sin(lon-PI), cos(lat), sin(lat)*cos(lon-PI)]
            // Preto stred prednej plochy z=1 nastane presne pri phi = -lon*PI/180 + PI:
            const targetPhi = -(lon * Math.PI) / 180 + Math.PI;
            const targetTheta = (lat * Math.PI) / 180;
            cobePhi = targetPhi;
            cobePhiOffset = 0;
            cobeThetaOffset = targetTheta - 0.2;
            cobeDragOffset = { phi: 0, theta: 0 };
            isGlobePaused = true;
            const btnIcon = document.getElementById('btn-globe-pause-icon');
            const btnText = document.getElementById('btn-globe-pause-text');
            const btn = document.getElementById('btn-globe-pause');
            if (btnIcon && btnText && btn) {
                btnIcon.innerText = '▶️';
                btnText.innerText = 'Spustiť rotáciu';
                btn.classList.add('border-cyan-500', 'text-cyan-300');
            }
            // Pri kliknutí na novú krajinu zrušíme predchádzajúci filter, aby sa načítali všetky správy novej krajiny
            radarActiveFilterWords.clear();
            toggleRadarWordInput(false);
            loadGlobeCountryArticles(iso, name, count);
        }

        // --- Správa kľúčových slov a filtrovania v Radare Krajiny ---
        let currentGlobeCountryArticles = [];
        let currentSelectedCountryIso = '';
        let currentSelectedCountryName = '';
        let currentCountryTotalCount = 0;
        let radarActiveFilterWords = new Set(); // Množina aktívne zvolených slov (multi-select)
        let cachedSystemAlerts = []; // Uložené systémové alarmy z /api/alerts

        function getRadarCustomWords() {
            try {
                return JSON.parse(localStorage.getItem('tep_radar_custom_words') || '[]');
            } catch (e) { return []; }
        }

        function saveRadarCustomWords(words) {
            localStorage.setItem('tep_radar_custom_words', JSON.stringify(words));
        }

        async function loadRadarSystemAlertsPresets() {
            const listEl = document.getElementById('radar-preset-alerts-list');
            if (!listEl) return;
            try {
                if (!cachedSystemAlerts || cachedSystemAlerts.length === 0) {
                    const res = await fetch('/api/alerts');
                    cachedSystemAlerts = await res.json();
                }
                const activeCustom = getRadarCustomWords().map(w => w.toLowerCase());
                if (cachedSystemAlerts.length === 0) {
                    listEl.innerHTML = '<span class="text-[10px] text-gray-500 italic">Žiadne vytvorené alarmy</span>';
                    return;
                }
                let html = '';
                cachedSystemAlerts.forEach(al => {
                    const isSelected = isWordActiveInFilter(al.name);
                    const isAlreadyAdded = activeCustom.includes(al.name.toLowerCase());
                    html += `
                        <button onclick="togglePresetAlertFilter('${al.name.replace(/'/g, "\'")}', '${(al.query_pattern || '').replace(/'/g, "\'")}')" 
                                class="px-2 py-0.5 rounded-md text-[10.5px] font-medium flex items-center gap-1 border transition ${
                                    isSelected 
                                    ? 'bg-red-600 border-red-400 text-white shadow-sm ring-1 ring-red-400' 
                                    : (isAlreadyAdded 
                                        ? 'bg-red-950/60 border-red-800 text-red-300' 
                                        : 'bg-gray-900 hover:bg-red-950/90 border-gray-700 hover:border-red-600 text-gray-200 hover:text-white')
                                }"
                                title="${isSelected ? 'Tento alarm je zvolený (kliknutím ho vypneš)' : 'Kliknutím pridáš/zapneš tento alarm do filtra'}">
                            <span class="w-1.5 h-1.5 rounded-full ${isSelected ? 'bg-white animate-ping' : 'bg-red-500'}"></span>
                            <span>${al.name}</span>
                            ${isSelected ? '<span class="text-[9px] text-white font-bold">✓</span>' : '<span class="text-[9px] text-gray-400">➕</span>'}
                        </button>
                    `;
                });
                listEl.innerHTML = html;
            } catch (err) {
                console.error(err);
                listEl.innerHTML = '<span class="text-[10px] text-red-400">Chyba načítania alarmov</span>';
            }
        }

        function toggleRadarWordInput(forceState) {
            const box = document.getElementById('radar-add-word-box');
            if (!box) return;
            const willShow = forceState !== undefined ? forceState : box.classList.contains('hidden');
            if (willShow) {
                box.classList.remove('hidden');
                const inp = document.getElementById('radar-new-word-input');
                if (inp) { inp.value = ''; inp.focus(); }
                loadRadarSystemAlertsPresets();
            } else {
                box.classList.add('hidden');
            }
        }

        function isWordActiveInFilter(word) {
            if (!word || radarActiveFilterWords.size === 0) return false;
            const wLower = word.toLowerCase();
            for (let act of radarActiveFilterWords) {
                const actLower = act.toLowerCase();
                if (actLower === wLower || actLower.startsWith(wLower) || wLower.startsWith(actLower)) {
                    return true;
                }
            }
            return false;
        }

        // Zozbieraj všetky dostupné slová pre krajinu (systémové alarmy + detegované + custom)
        function getAllAvailableRadarWords() {
            const words = new Set();
            if (cachedSystemAlerts && cachedSystemAlerts.length > 0) {
                cachedSystemAlerts.forEach(al => words.add(al.name));
            }
            getRadarCustomWords().forEach(w => words.add(w));
            currentGlobeCountryArticles.forEach(a => {
                const kws = getArticleDetectedKeywords(a);
                kws.forEach(k => words.add(k.alertName || k.word));
            });
            return Array.from(words);
        }

        // Zvoľ naraz VŠETKY kľúčové slová
        async function selectAllRadarWords() {
            if (!cachedSystemAlerts || cachedSystemAlerts.length === 0) {
                try {
                    const res = await fetch('/api/alerts');
                    cachedSystemAlerts = await res.json();
                } catch(e) {}
            }
            const allWords = getAllAvailableRadarWords();
            radarActiveFilterWords.clear();
            allWords.forEach(w => radarActiveFilterWords.add(w));
            
            toggleRadarWordInput(false);
            renderRadarActiveWords();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        // Kliknutie na preset alarm v dialógu (zapne/vypne v multi-selecte)
        function togglePresetAlertFilter(alertName, queryPattern) {
            let words = getRadarCustomWords();
            if (!words.some(w => w.toLowerCase() === alertName.toLowerCase())) {
                words.push(alertName);
                saveRadarCustomWords(words);
            }

            if (isWordActiveInFilter(alertName)) {
                // Odstránime zo zvolených
                for (let act of Array.from(radarActiveFilterWords)) {
                    if (act.toLowerCase() === alertName.toLowerCase() || act.toLowerCase().startsWith(alertName.toLowerCase()) || alertName.toLowerCase().startsWith(act.toLowerCase())) {
                        radarActiveFilterWords.delete(act);
                    }
                }
            } else {
                radarActiveFilterWords.add(alertName);
            }

            renderRadarActiveWords();
            loadRadarSystemAlertsPresets();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        function addRadarCustomWord() {
            const inp = document.getElementById('radar-new-word-input');
            if (!inp) return;
            const word = inp.value.trim();
            if (!word) return;

            let words = getRadarCustomWords();
            if (!words.some(w => w.toLowerCase() === word.toLowerCase())) {
                words.push(word);
                saveRadarCustomWords(words);
            }
            toggleRadarWordInput(false);
            // Pridáme a zapneme v aktívnom filtri
            radarActiveFilterWords.add(word);
            renderRadarActiveWords();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        function removeRadarCustomWord(word, event) {
            if (event) event.stopPropagation();
            let words = getRadarCustomWords().filter(w => w.toLowerCase() !== word.toLowerCase());
            saveRadarCustomWords(words);
            
            for (let act of Array.from(radarActiveFilterWords)) {
                if (act.toLowerCase() === word.toLowerCase()) {
                    radarActiveFilterWords.delete(act);
                }
            }
            renderRadarActiveWords();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        // Kliknutie na konkrétny tag kľúčového slova (zapína / vypína dané slovo)
        function toggleRadarFilterWord(word) {
            const wLower = (word || '').toLowerCase();
            let foundKey = null;
            for (let act of radarActiveFilterWords) {
                const actLower = act.toLowerCase();
                if (actLower === wLower || actLower.startsWith(wLower) || wLower.startsWith(actLower)) {
                    foundKey = act;
                    break;
                }
            }

            if (foundKey) {
                // Vypneme toto jedno slovo
                radarActiveFilterWords.delete(foundKey);
            } else {
                // Zapneme toto slovo do filtra
                radarActiveFilterWords.add(word);
            }

            renderRadarActiveWords();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        function clearRadarFilter() {
            radarActiveFilterWords.clear();
            renderRadarActiveWords();
            loadGlobeCountryArticles(currentSelectedCountryIso, currentSelectedCountryName, currentCountryTotalCount);
        }

        // Zistenie kľúčového vyhľadávacieho dotazu pre viacero zvolených slov naraz
        function getSearchQueryForActiveWords() {
            if (radarActiveFilterWords.size === 0) return '';
            const queryParts = [];
            radarActiveFilterWords.forEach(word => {
                const wLower = word.toLowerCase();
                if (cachedSystemAlerts && cachedSystemAlerts.length > 0) {
                    const found = cachedSystemAlerts.find(al => al.name.toLowerCase() === wLower);
                    if (found && found.query_pattern) {
                        const pats = found.query_pattern.split('|').map(p => p.trim()).filter(Boolean);
                        if (pats.length > 0) {
                            queryParts.push(pats[0]);
                            return;
                        }
                    }
                }
                queryParts.push(word.split('(')[0].trim());
            });
            // Spojíme cez ' OR ' aby FTS5 multilingválny expander vyhľadal články obsahujúce aspoň jedno z aktívnych slov
            return queryParts.join(' OR ');
        }

        // Zistenie zoznamu záchytov kľúčových slov a alarmov pre konkrétny článok
        function getArticleDetectedKeywords(a) {
            const detected = [];
            const seen = new Set();

            // 1. Oficiálne alarmy z DB (matched_alerts)
            if (a.matched_alerts && a.matched_alerts.length > 0) {
                a.matched_alerts.forEach(al => {
                    const key = (al.matched_word || al.alert_name).toLowerCase();
                    if (!seen.has(key)) {
                        seen.add(key);
                        detected.push({
                            type: 'alert',
                            alertName: al.alert_name,
                            word: al.matched_word || al.alert_name
                        });
                    }
                });
            }

            // 2. Skontroluj text článku oproti uloženým kľúčovým slovám / vybraným alarmom (custom words)
            const textToSearch = [
                a.title_orig || '',
                a.title_sk || '',
                a.title_en || '',
                a.perex_orig || '',
                a.perex_sk || ''
            ].join(' ').toLowerCase();

            const customWords = getRadarCustomWords();
            customWords.forEach(w => {
                const wLower = w.toLowerCase();
                
                let matchedInAlert = false;
                if (cachedSystemAlerts && cachedSystemAlerts.length > 0) {
                    const foundAl = cachedSystemAlerts.find(al => al.name.toLowerCase() === wLower);
                    if (foundAl && foundAl.query_pattern) {
                        const patterns = foundAl.query_pattern.split('|').map(p => p.trim().toLowerCase()).filter(Boolean);
                        for (let p of patterns) {
                            if (textToSearch.includes(p)) {
                                matchedInAlert = true;
                                if (!seen.has(wLower)) {
                                    seen.add(wLower);
                                    detected.push({
                                        type: 'preset_alert',
                                        alertName: foundAl.name,
                                        word: p
                                    });
                                }
                                break;
                            }
                        }
                    }
                }

                if (!matchedInAlert && textToSearch.includes(wLower) && !seen.has(wLower)) {
                    seen.add(wLower);
                    detected.push({
                        type: 'custom',
                        alertName: 'Filter',
                        word: w
                    });
                }
            });

            // 3. Ak je zadaný globálny query filter na glóbuse alebo v článku
            if (a.searched_word && !seen.has(a.searched_word.toLowerCase())) {
                seen.add(a.searched_word.toLowerCase());
                detected.push({
                    type: 'search',
                    alertName: 'Hľadané',
                    word: a.searched_word
                });
            }

            return detected;
        }

        function renderRadarActiveWords() {
            const wordsHeader = document.getElementById('globe-radar-active-words');
            const statusEl = document.getElementById('radar-filter-status');
            const clearBtn = document.getElementById('btn-clear-all-words');
            if (!wordsHeader) return;

            // Zozbieraj všetky alarmy zachytené v načítaných článkoch danej krajiny
            const detectedMap = new Map(); // key -> { alertName, type, word }
            currentGlobeCountryArticles.forEach(a => {
                const kws = getArticleDetectedKeywords(a);
                kws.forEach(k => {
                    const key = (k.alertName || k.word).toLowerCase();
                    if (!detectedMap.has(key)) {
                        detectedMap.set(key, { alertName: k.alertName, type: k.type, word: k.alertName || k.word });
                    }
                });
            });

            // Pridaj aj systémové alarmy a custom pridané slová
            if (cachedSystemAlerts && cachedSystemAlerts.length > 0) {
                cachedSystemAlerts.forEach(al => {
                    const key = al.name.toLowerCase();
                    if (!detectedMap.has(key)) {
                        detectedMap.set(key, { alertName: al.name, type: 'preset_alert', word: al.name });
                    }
                });
            }

            const customWords = getRadarCustomWords();
            customWords.forEach(cw => {
                const cwLower = cw.toLowerCase();
                if (!detectedMap.has(cwLower)) {
                    const isSystemAlert = cachedSystemAlerts && cachedSystemAlerts.some(al => al.name.toLowerCase() === cwLower);
                    detectedMap.set(cwLower, { 
                        alertName: isSystemAlert ? cw : 'Vlastné', 
                        type: isSystemAlert ? 'preset_alert' : 'custom', 
                        word: cw 
                    });
                }
            });

            if (detectedMap.size === 0 && !globeQuery && radarActiveFilterWords.size === 0) {
                wordsHeader.innerHTML = '<span class="text-[10px] text-gray-500 italic">Klikni na ➕ pre pridanie slov alebo ⚡ Všetky slová</span>';
                if (statusEl) statusEl.innerText = '';
                if (clearBtn) clearBtn.classList.add('hidden');
                return;
            }

            let html = '';
            detectedMap.forEach((info, key) => {
                const isSelected = isWordActiveInFilter(info.alertName) || isWordActiveInFilter(info.word);
                const isCustom = customWords.map(w => w.toLowerCase()).includes(key) || customWords.map(w => w.toLowerCase()).includes(info.word.toLowerCase());
                
                // Určenie farby a štýlu tagu
                let bgBorder = 'bg-gray-900/90 border-gray-700 text-gray-300 hover:border-gray-500 opacity-70';
                if (isSelected) {
                    bgBorder = 'bg-red-600 border-red-400 text-white shadow-lg shadow-red-600/40 ring-2 ring-red-400/50 opacity-100 font-bold';
                } else if (info.type === 'custom') {
                    bgBorder = 'bg-blue-950/60 border-blue-800 text-blue-300 hover:border-blue-600 opacity-80';
                } else if (info.type === 'preset_alert') {
                    bgBorder = 'bg-amber-950/60 border-amber-800 text-amber-300 hover:border-amber-600 opacity-80';
                }

                html += `
                    <div onclick="toggleRadarFilterWord('${info.word.replace(/'/g, "\'")}')" 
                         class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border text-[11px] font-mono cursor-pointer transition select-none ${bgBorder}"
                         title="${isSelected ? 'Slovo je AKTÍVNE vo filtri (kliknutím ho vypneš)' : 'Kliknutím zapneš toto slovo do filtra'}">
                        <span class="w-1.5 h-1.5 rounded-full ${isSelected ? 'bg-white animate-ping' : 'bg-gray-500'}"></span>
                        <span class="font-bold opacity-80 text-[10px]">${info.alertName}:</span>
                        <span>${info.word}</span>
                        ${isSelected ? '<span class="text-[10px] font-bold text-white ml-0.5">✓</span>' : '<span class="text-[10px] opacity-40 ml-0.5">○</span>'}
                        ${isCustom ? `
                            <button onclick="removeRadarCustomWord('${info.word.replace(/'/g, "\'")}', event)" 
                                    class="ml-1 text-gray-300 hover:text-white hover:bg-black/40 rounded px-1 text-[10px] leading-none transition" 
                                    title="Zmazať toto vlastné slovo zo zoznamu">✕</button>
                        ` : ''}
                    </div>
                `;
            });

            if (radarActiveFilterWords.size > 0) {
                if (clearBtn) clearBtn.classList.remove('hidden');
                if (statusEl) {
                    statusEl.innerHTML = `<span class="text-amber-400 font-bold">• ${radarActiveFilterWords.size} slov aktívnych</span>`;
                }
            } else {
                if (clearBtn) clearBtn.classList.add('hidden');
                if (statusEl) statusEl.innerText = '';
            }

            wordsHeader.innerHTML = html;
        }

        function renderFilteredGlobeArticles() {
            const container = document.getElementById('globe-country-articles');
            const countEl = document.getElementById('globe-selected-count');
            if (!container) return;

            let filtered = currentGlobeCountryArticles;

            if (countEl) {
                if (radarActiveFilterWords.size > 0) {
                    countEl.innerHTML = `<span class="text-amber-300">${filtered.length} nájdených</span> / ${currentCountryTotalCount}`;
                } else {
                    countEl.innerText = `${currentCountryTotalCount} správ`;
                }
