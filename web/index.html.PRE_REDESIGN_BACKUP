    <!-- JS Logic -->
    <script>
        let currentCountry = '';
        let currentPeriod = 'all';
        let currentQuery = '';
        let currentArticleData = null;
        let currentModalLang = 'sk';
        let globeInstance = null;
        let globeMarkers = [];
        let globePhi = 0;
        let globeTheta = 0.3;
        let globePeriod = '1h';
        let globeQuery = '';
        let pointerInteracting = null;
        let pointerInteractionMovement = 0;

        function switchView(view) {
            const feedView = document.getElementById('view-feed');
            const alertsView = document.getElementById('view-alerts');
            const sourcesView = document.getElementById('view-sources');
            const globeView = document.getElementById('view-globe');
            const favView = document.getElementById('view-favorites');
            const tabFeed = document.getElementById('tab-feed');
            const tabAlerts = document.getElementById('tab-alerts');
            const tabSources = document.getElementById('tab-sources');
            const tabGlobe = document.getElementById('tab-globe');
            const tabFav = document.getElementById('tab-favorites');

            // Skryť všetky
            feedView.classList.add('hidden');
            alertsView.classList.add('hidden');
            sourcesView.classList.add('hidden');
            globeView.classList.add('hidden');
            if (favView) favView.classList.add('hidden');
            [tabFeed, tabAlerts, tabSources, tabGlobe, tabFav].forEach(t => {
                if (t) {
                    t.classList.remove('active-tab');
                    t.classList.add('text-gray-400');
                }
            });

            if (view === 'feed') {
                feedView.classList.remove('hidden');
                tabFeed.classList.add('active-tab');
                tabFeed.classList.remove('text-gray-400');
            } else if (view === 'alerts') {
                alertsView.classList.remove('hidden');
                tabAlerts.classList.add('active-tab');
                tabAlerts.classList.remove('text-gray-400');
                loadManageAlerts();
            } else if (view === 'sources') {
                sourcesView.classList.remove('hidden');
                tabSources.classList.add('active-tab');
                tabSources.classList.remove('text-gray-400');
                loadManageSources();
            } else if (view === 'globe') {
                globeView.classList.remove('hidden');
                tabGlobe.classList.add('active-tab');
                tabGlobe.classList.remove('text-gray-400');
                fetch('/api/alerts').then(r => r.json()).then(al => { cachedSystemAlerts = al; renderRadarActiveWords(); }).catch(() => {});
                initOrUpdateGlobe();
            } else if (view === 'favorites') {
                if (favView) favView.classList.remove('hidden');
                if (tabFav) {
                    tabFav.classList.add('active-tab');
                    tabFav.classList.remove('text-gray-400');
                }
                loadFavorites();
            }
        }

        function setPeriod(p) {
            currentPeriod = p;
            document.querySelectorAll('.time-pill').forEach(el => el.classList.remove('active'));
            const activeEl = document.getElementById(`p-${p}`);
            if (activeEl) activeEl.classList.add('active');
            updateBadge();
            loadCountries();
            loadStats();
            loadArticles(currentCountry, currentQuery);
            if (currentQuery) analyzeKeyword();
        }

        function updateBadge() {
            const countryText = currentCountry ? currentCountry : 'Všetky krajiny';
            const periodMap = {'1h':'1 hodina', '6h':'6 hodín', '24h':'24 hodín', '7d':'7 dní', '30d':'30 dní', 'all':'Celá história'};
            document.getElementById('current-filter-badge').innerText = `${countryText} · ${periodMap[currentPeriod] || currentPeriod}`;
        }

        async function loadStats() {
            try {
                const res = await fetch(`/api/stats?period=${currentPeriod}`);
                const d = await res.json();
                document.getElementById('stat-articles').innerText = d.total_articles;
                document.getElementById('stat-media').innerText = d.total_media;
                document.getElementById('stat-alerts').innerText = d.total_alerts;
                document.getElementById('badge-alerts-count').innerText = d.total_alarm_hits;
                if (document.getElementById('badge-favorites-count')) {
                    document.getElementById('badge-favorites-count').innerText = d.total_favorites !== undefined ? d.total_favorites : 0;
                }
            } catch (e) { console.error(e); }
        }

        async function loadCountries() {
            try {
                let url = `/api/countries?period=${currentPeriod}`;
                if (currentQuery) url += `&query=${encodeURIComponent(currentQuery)}`;
                const res = await fetch(url);
                const list = await res.json();
                const container = document.getElementById('country-list');
                let totalAll = list.reduce((acc, c) => acc + (c.article_count || 0), 0);
                let html = `
                    <button onclick="filterCountry('')" class="w-full text-left px-3 py-1.5 rounded-lg ${currentCountry === '' ? 'bg-blue-600 font-bold' : 'bg-gray-800/80 hover:bg-gray-700'} text-xs flex justify-between items-center transition">
                        <span>🌐 Všetky krajiny</span>
                        <span class="text-[10px] text-gray-300 bg-gray-900/90 px-1.5 py-0.5 rounded font-mono">${totalAll}</span>
                    </button>
                `;
                list.forEach(c => {
                    const active = currentCountry === c.iso_code;
                    html += `
                        <div class="flex items-center justify-between px-3 py-1.5 rounded-lg ${active ? 'bg-blue-600 font-bold' : 'bg-gray-800/60 hover:bg-gray-700/80'} text-xs transition group">
                            <button onclick="filterCountry('${c.iso_code}', '${c.name_sk}')" class="flex-1 text-left truncate flex items-center justify-between pr-2">
                                <span class="truncate">${c.name_sk} (${c.iso_code})</span>
                                <span class="text-[10px] ${c.article_count > 0 ? 'text-blue-200 font-bold bg-blue-950/90 border border-blue-800/80' : 'text-gray-500 bg-gray-900'} px-1.5 py-0.5 rounded font-mono">${c.article_count}</span>
                            </button>
                            <button onclick="openCountrySources('${c.iso_code}')" title="Zobraziť a spravovať webstránky pre ${c.name_sk}" class="ml-1 text-[10px] text-amber-300 hover:text-amber-200 bg-amber-950/70 hover:bg-amber-900 border border-amber-800/70 px-1.5 py-0.5 rounded flex items-center gap-1 transition">
                                <span>📡</span>
                                <span class="font-bold">${c.media_count || 0}</span>
                            </button>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (e) { console.error(e); }
        }

        async function loadArticles(country = '', query = '') {
            const container = document.getElementById('articles-container');
            container.innerHTML = '<div class="text-center py-12 text-gray-500 text-xs">Načítavam články...</div>';
            try {
                let url = `/api/articles?limit=60&period=${currentPeriod}`;
                if (country) url += `&country=${country}`;
                if (query) url += `&query=${encodeURIComponent(query)}`;
                const res = await fetch(url);
                const articles = await res.json();

                if (articles.length === 0) {
                    container.innerHTML = '<div class="text-center py-12 text-gray-500 text-xs">Žiadne články pre zvolený filter a obdobie.</div>';
                    return;
                }

                let html = '';
                articles.forEach(a => {
                    const dateObj = new Date(a.published_at || a.scraped_at);
                    const timeStr = dateObj.toLocaleDateString([], {day:'2-digit', month:'2-digit'}) + ' ' + dateObj.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    html += `
                        <div onclick="openArticleModal(${a.id})" class="glass-panel p-4 rounded-xl hover:border-blue-500/60 hover:bg-gray-900/90 transition cursor-pointer">
                            <div class="flex items-center justify-between text-xs text-gray-400 mb-1.5">
                                <span class="font-medium text-blue-400 flex items-center gap-1.5">
                                    ${(a.url && a.url.includes('t.me')) || (a.media_name && a.media_name.includes('TG')) ? '<span class="px-1 py-0.2 bg-cyan-950 text-cyan-300 border border-cyan-800 rounded text-[9px] font-bold">✈️ TG</span>' : ''}
                                    <span>${a.media_name} · ${a.country_name}</span>
                                </span>
                                <div class="flex items-center gap-2">
                                    <button onclick="event.stopPropagation(); toggleCardFavorite(${a.id}, this)" class="p-1 rounded hover:bg-gray-800 transition ${a.is_favorite ? 'text-amber-400' : 'text-gray-500 hover:text-amber-400'}" title="${a.is_favorite ? 'Odstrániť z knižnice' : 'Uložiť do knižnice'}">
                                        ${a.is_favorite ? '★' : '☆'}
                                    </button>
                                    <span class="text-[11px] text-gray-500">${timeStr}</span>
                                </div>
                            </div>
                            
                            <!-- Originálny Titulok -->
                            <div class="text-sm font-semibold text-white mb-2 leading-snug">
                                ${a.title_orig}
                            </div>

